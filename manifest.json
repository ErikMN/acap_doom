{
    "schemaVersion": "2.0.0",
    "resources": {
        "dbus": {
            "requiredMethods": [
                "com.axis.Graphics2.*",
                "com.axis.Overlay2.*"
            ]
        },
        "linux": {
            "user": {
                "groups": [
                    "gpu"
                ]
            }
        }
    },
    "acapPackageConf": {
        "setup": {
            "appName": "acap_doom",
            "friendlyName": "ACAP DOOM",
            "vendor": "-",
            "vendorId": "1234567890",
            "version": "1.2.0",
            "compatibleOsVersions": [
                {
                    "min": "11.11.220",
                    "max": "13"
                }
            ],
            "runMode": "never"
        },
        "installation": {
            "postInstallScript": "postinstall.sh"
        },
        "configuration": {
            "settingPage": "index.html",
            "reverseProxy": [
                {
                    "apiPath": "control",
                    "target": "ws://127.0.0.1:9000",
                    "access": "admin"
                }
            ]
        }
    }
}
